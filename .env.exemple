# --- SZERVER BEÁLLÍTÁSOK ---
PORT=3000
NODE_ENV=development

# --- ADATBÁZIS (MongoDB) ---
# Ha helyi Docker: mongodb://mongodb:27017/verseny_db
# Ha MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/verseny
MONGO_URI=mongodb://localhost:27017/verseny_db

# --- BIZTONSÁG (JWT) ---
# pl: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- AI INTEGRÁCIÓ (OpenAI) ---
# OpenAI dashboardon generált 'sk-...' kezdetű kulcs
OPENAI_API_KEY=sk-your-openai-api-key-here
GPT_MODEL=gpt-4o-mini

# --- ADMIN ALAPÉRTELMEZETT ADATOK ---
# Az első indításkor ezzel tudsz majd belépni (ha megírod a scriptet)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=adminpassword